# ============================================================
# CLERK AUTHENTICATION
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============================================================
# SUPABASE (PostgreSQL via Prisma)
# ============================================================
# Copy both URLs from: Dashboard → Connect → ORM → Prisma
# Use the Supavisor *pooler* host (aws-0-…pooler.supabase.com), NOT db.*.supabase.co
# — the db.* host is often IPv6-only and fails on many local networks.
#
# App queries (transaction pooler, port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations / db push (session pooler, port 5432):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
# Local dev alternative: use session pooler (5432) for DATABASE_URL too (no ?pgbouncer=true).

# Supabase client (for Storage operations)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# AWS S3 (Optional – use if preferring S3 over Supabase Storage)
# ============================================================
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-private-product-bucket

# ============================================================
# STORAGE PROVIDER: "supabase" | "s3"
# ============================================================
STORAGE_PROVIDER=supabase

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=dhanesh.kum15@gmail.com

# Optional: show Next.js "N" dev overlay (Route / Turbopack) in npm run dev
# Leave unset for normal UX; admins can set true locally only
# SHOW_NEXT_DEV_INDICATOR=true
